<?xml version="1.0" encoding="UTF-8" ?>
<!-- Risks & Issues screen — mirrors React/Blazor RisksPage:
     SearchBar + severity Picker + status Picker + SfDataGrid
     (Number · Title · Severity · Status · ImpactDisplay · Owner · Identified). -->
<controls:ScreenBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                     xmlns:controls="clr-namespace:Construction.Maui.Controls"
                     xmlns:syncfusion="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
                     xmlns:vm="clr-namespace:Construction.Maui.ViewModels"
                     xmlns:models="clr-namespace:Construction.Maui.Models"
                     x:Class="Construction.Maui.Views.RisksPage"
             x:DataType="vm:RisksViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray900}}"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="{StaticResource PagePadding}" RowSpacing="{StaticResource SpaceLg}">

        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label Text="Risks &amp; Issues" Style="{StaticResource TextH1}" />
            <Label Text="Active risks across the portfolio with severity, impact, and mitigation."
                   Style="{StaticResource TextBodyMuted}" />
        </VerticalStackLayout>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="{StaticResource SpaceMd}">
            <SearchBar Grid.Column="0"
                       Placeholder="Search risks by title, number, owner…"
                       Text="{Binding SearchText}"
                       SearchCommand="{Binding SearchCommand}" />
            <Picker Grid.Column="1" Title="Severity" WidthRequest="150"
                    ItemsSource="{Binding SeverityOptions}" SelectedItem="{Binding SelectedSeverity}" />
            <Picker Grid.Column="2" Title="Status" WidthRequest="170"
                    ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" />
            <Button Grid.Column="3" Style="{StaticResource ButtonPrimary}" Text="Apply"
                    Clicked="OnApplyFilters" />
        </Grid>

        <ActivityIndicator Grid.Row="2" IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}"
                           VerticalOptions="Center" HorizontalOptions="Center" />
        <Border Grid.Row="2" IsVisible="{Binding HasError}" Style="{StaticResource CardBorder}"
                Stroke="{AppThemeBinding Light={StaticResource Error600}, Dark={StaticResource Error500}}">
            <Label Text="{Binding ErrorMessage}" TextColor="{AppThemeBinding Light={StaticResource Error600}, Dark={StaticResource Error500}}" />
        </Border>

        <!-- DataGrid. ColumnWidthMode="Auto" (Phase 3 item 11) — columns size to
             content and the grid scrolls horizontally on narrow widths, keeping the
             grid usable on a phone without compressing columns. -->
        <syncfusion:SfDataGrid Grid.Row="2"
                               IsVisible="{Binding HasData}"
                               ItemsSource="{Binding Risks}"
                               SelectionMode="None"
                               GridLinesVisibility="Horizontal"
                               HeaderGridLinesVisibility="Horizontal"
                               AutoGenerateColumnsMode="None"
                               ColumnWidthMode="Auto"
                               RowHeight="44"
                               HeaderRowHeight="44">
            <syncfusion:SfDataGrid.Columns>
                <syncfusion:DataGridTextColumn MappingName="Number" HeaderText="Number" />
                <syncfusion:DataGridTextColumn MappingName="Title" HeaderText="Title" />
                <syncfusion:DataGridTextColumn MappingName="Severity" HeaderText="Severity" />
                <syncfusion:DataGridTextColumn MappingName="Status" HeaderText="Status" />
                <syncfusion:DataGridTextColumn MappingName="ImpactDisplay" HeaderText="Impact" />
                <syncfusion:DataGridTextColumn MappingName="Owner" HeaderText="Owner" />
                <syncfusion:DataGridTextColumn MappingName="IdentifiedDate" HeaderText="Identified" />
                <syncfusion:DataGridTextColumn MappingName="TargetResolutionDate" HeaderText="Target Resolution" />
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>

        <HorizontalStackLayout Grid.Row="3" Spacing="{StaticResource SpaceMd}" HorizontalOptions="End" VerticalOptions="Center">
            <Button Style="{StaticResource ButtonSecondary}" Text="&#x2190; Prev" Command="{Binding PreviousPageCommand}" />
            <Label VerticalOptions="Center" Style="{StaticResource TextSmall}">
                <Label.Text>
                    <MultiBinding StringFormat="Page {0} of {1} ({2} risks)">
                        <Binding Path="CurrentPage" />
                        <Binding Path="TotalPages" />
                        <Binding Path="TotalCount" />
                    </MultiBinding>
                </Label.Text>
            </Label>
            <Button Style="{StaticResource ButtonSecondary}" Text="Next &#x2192;" Command="{Binding NextPageCommand}" />
        </HorizontalStackLayout>

    </Grid>
</controls:ScreenBase>
