<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\..\backend\Construction.Core\Construction.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Syncfusion.Blazor.Charts" Version="34.1.29" />
    <PackageReference Include="Syncfusion.Blazor.Core" Version="34.1.29" />
    <PackageReference Include="Syncfusion.Blazor.Grid" Version="34.1.29" />
    <PackageReference Include="Syncfusion.Blazor.HeatMap" Version="34.1.29" />
    <PackageReference Include="Syncfusion.Blazor.SfPdfViewer" Version="34.1.29" />
    <PackageReference Include="Syncfusion.Blazor.Themes" Version="34.1.29" />
    <PackageReference Include="Syncfusion.Licensing" Version="34.1.29" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>construction-blazor-3d7c9e2a-1b4f-4a6d-9c8e-2f5a7b3d6e1c</UserSecretsId>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- A manual "dotnet publish -o ./publish" output folder lives inside the project dir;
         exclude it from source globbing so its copied wwwroot/*.razor.js etc. aren't picked
         up as if they were project source (BLAZOR106). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);publish\**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
